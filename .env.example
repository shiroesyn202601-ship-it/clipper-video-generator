# Copy to .env and adjust. Relative paths are resolved from the repo root.
SERVER_PORT=5174
WORKSPACE_DIR=./workspace
# Max upload size in megabytes
MAX_UPLOAD_MB=8192

# Python inside the project venv (macOS/Linux: ./.venv/bin/python)
PYTHON_BIN=./.venv/Scripts/python.exe

YTDLP_BIN=./.venv/Scripts/yt-dlp.exe
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# JavaScript runtime yt-dlp needs for YouTube (SETUP.md step 1)
DENO_BIN=deno

# macOS/Linux: ./tools/whisper.cpp/build/bin/whisper-cli
WHISPER_BIN=./tools/whisper-bin/whisper-cli.exe
WHISPER_MODEL=./tools/whisper.cpp/models/ggml-medium.bin
WHISPER_THREADS=4

FACE_MODEL=./tools/models/face_detection_yunet_2023mar.onnx

DEMUCS_MODEL=htdemucs
# cpu or cuda
DEMUCS_DEVICE=cpu
